# Production environment for Urdu Video Studio (T095b).
#
# The real file lives ONLY on the VPS at /opt/uvs/.env, mode 600 (root only):
#     chmod 600 /opt/uvs/.env
# Never commit it, never copy it back to your laptop. Generate secrets ON the VPS:
#     openssl rand -hex 32
# Values: no quotes, no spaces around "=". After editing, apply with:
#     /opt/uvs/uvs up -d --force-recreate backend worker scheduler
#
# DATABASE_URL and REDIS_URL are NOT set here: docker-compose.prod.yml builds them from
# the POSTGRES_* values below and the internal service names.

# --- Database (used by the postgres container AND to build the app's DATABASE_URL) ---
POSTGRES_USER=uvs
POSTGRES_DB=uvs
# Hex only (it is embedded in a URL): openssl rand -hex 24
# Changing it later does NOT change the password inside an existing database.
POSTGRES_PASSWORD=

# --- Time zone (logs, cron, backup file names; daily limits always reset at midnight Asia/Karachi) ---
TZ=Asia/Karachi

# --- Video pipeline: real GPU generation on RunPod Serverless ---
VIDEO_PROVIDER=runpod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# A job still unfinished after this many seconds is marked failed and the student's
# daily video is refunded (scheduler service).
MAX_PROCESSING_SECONDS=900

# --- Storage: Cloudflare R2 (videos, thumbnails, intermediate clips) ---
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- OpenAI (script generation + moderation) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Daily limits per student (server-enforced) ---
DAILY_VIDEO_LIMIT=5
DAILY_SCRIPT_LIMIT=20

# --- Public URL of the app (the "APP_BASE_URL"; used in password-reset emails) ---
# Before the domain exists (SSH tunnel testing): http://localhost:3100
# When the domain is live:                      https://your-domain.example
FRONTEND_BASE_URL=http://localhost:3100

# --- Email (Resend) for password resets ---
# Leave RESEND_API_KEY empty to only log reset links (podman logs uvs-backend).
# EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=no-reply@your-domain.example

# --- Sessions / CSRF ---
# openssl rand -hex 32. Changing it logs everyone out and invalidates download links.
SESSION_COOKIE_SECRET=
SESSION_TTL_SECONDS=604800
CSRF_COOKIE_NAME=csrf_token
# Keep true. Browsers still send Secure cookies to http://localhost (the SSH tunnel).
COOKIE_SECURE=true

# --- CPU budget for video assembly (the worker container also runs at nice 10) ---
FFMPEG_THREADS=2
