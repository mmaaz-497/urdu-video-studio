# Default is "/api" (see next.config.ts rewrites in T031a) so session/CSRF
# cookies are first-party in dev; override only for non-rewrite setups.
NEXT_PUBLIC_API_BASE_URL=/api

# Backend origin that the "/api/*" rewrite above proxies to. Read at BUILD time.
# Production: Apache routes /api/* straight to the backend (infra/apache/), and the
# image is built with BACKEND_ORIGIN=http://backend:8000 so the rewrite still works
# as a fallback (e.g. through an SSH tunnel before the domain exists).
BACKEND_ORIGIN=http://127.0.0.1:8000
