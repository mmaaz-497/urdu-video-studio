# --- Database ---
DATABASE_URL=postgresql+psycopg://urdu_video_studio:urdu_video_studio@localhost:5432/urdu_video_studio

# --- Redis (RQ queue + session store) ---
REDIS_URL=redis://localhost:6379/0

# --- Video pipeline provider ---
# mock: bundled placeholder assets, zero GPU cost (default for local dev)
# runpod: real GPU generation via RunPod Serverless (Phase 7)
VIDEO_PROVIDER=mock

# --- Storage provider ---
# local: disk-backed storage under LOCAL_STORAGE_PATH (default for local dev)
# r2: Cloudflare R2 (S3-compatible)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./.data/storage

# --- Cloudflare R2 (required when STORAGE_PROVIDER=r2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- OpenAI (script generation + moderation) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Daily usage limits (server-enforced, no client bypass) ---
DAILY_VIDEO_LIMIT=5
DAILY_SCRIPT_LIMIT=20

# --- Stale-job sweeper ---
MAX_PROCESSING_SECONDS=600

# --- Email (Resend, password reset) ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# --- Session / CSRF ---
SESSION_COOKIE_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=604800
CSRF_COOKIE_NAME=csrf_token

# --- RunPod (required when VIDEO_PROVIDER=runpod, Phase 7) ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
